{
  "name": "lazidrome",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "install-all": "npm install",
    "build": "npm run build -w frontend",
    "sync:frontend": "rsync -uav --delete ./frontend/dist/ hwaryong.com:/projects/lazidrome/frontend/dist",
    "sync:backend": "rsync -uav --delete --exclude-from='.rsync-ignore' ./backend/ hwaryong.com:/projects/lazidrome/backend",
    "sync": "npm run sync:frontend && npm run sync:backend",
    "deploy": "npm run build && npm run sync:frontend && npm run sync:backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}