# Copy to .env and fill in values (never commit .env)

ADMIN_PASSWORD=your-strong-password
JWT_SECRET=at-least-16-random-characters-here

# Optional
PORT=5294
NODE_ENV=development
TRACKS_PATH=./storage/tracks
IMAGES_PATH=./storage/images

# Comma-separated frontend origins (default: Vite dev ports)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://lazidrome.hwaryong.com

# LASTFM_API_KEY=
# LASTFM_API_SECRET=
# LASTFM_SESSION_KEY=
# STREAM_PREVIEW_SECONDS=30
# MEDIA_TOKEN_TTL_SEC=7200
